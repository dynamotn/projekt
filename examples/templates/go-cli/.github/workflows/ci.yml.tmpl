name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: {{ .Values.runner | default "ubuntu-latest" }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "{{ .Values.goVersion | default "1.24" }}"
      - run: make lint
      - run: make test
