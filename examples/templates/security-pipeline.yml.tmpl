# Generated from the {{ .Template }} template on {{ .Date }}.
# The GitHub expressions below are written as Go template strings, so the
# renderer hands them over untouched instead of trying to evaluate them.
name: {{ .Values.workflow | default "security" }}

on:
  push:
    branches: [{{ .Values.branch | default "main" }}]
  pull_request:
  schedule:
    - cron: "{{ .Values.cron | default "17 3 * * 1" }}"

permissions:
  contents: read
  security-events: write

jobs:
  secrets:
    name: Secret scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Scan history for secrets
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: {{ "${{ secrets.GITHUB_TOKEN }}" }}

  sast:
    name: Static analysis
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: {{ .Values.language | default "go" }}
      - name: Autobuild
        uses: github/codeql-action/autobuild@v3
      - name: Analyze
        uses: github/codeql-action/analyze@v3

  dependencies:
    name: Dependency and image scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Scan the filesystem
        uses: aquasecurity/trivy-action@0.28.0
        with:
          scan-type: fs
          scanners: vuln,secret,misconfig
          severity: {{ .Values.severity | default "HIGH,CRITICAL" }}
          exit-code: {{ .Values.failOnFinding | default 1 }}
          format: sarif
          output: trivy.sarif
      - name: Upload the findings
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: trivy.sarif
{{- with .Values.images }}

  images:
    name: Image scan
    runs-on: ubuntu-latest
    strategy:
      matrix:
        image: [{{ range $i, $image := . }}{{ if $i }}, {{ end }}"{{ $image }}"{{ end }}]
    steps:
      - name: Scan {{ "${{ matrix.image }}" }}
        uses: aquasecurity/trivy-action@0.28.0
        with:
          image-ref: {{ "${{ matrix.image }}" }}
          severity: CRITICAL
          exit-code: 1
{{- end }}
