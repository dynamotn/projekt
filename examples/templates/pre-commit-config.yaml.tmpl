# Generated from the {{ .Template }} template on {{ .Date }} for {{ .Project }}.
# Install with: pre-commit install
default_install_hook_types: [pre-commit, commit-msg]
fail_fast: {{ .Values.failFast | default false }}

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: {{ .Values.hooksRev | default "v5.0.0" }}
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-merge-conflict
      - id: check-added-large-files
        args: [--maxkb={{ .Values.maxFileKB | default 512 }}]
      - id: detect-private-key

  - repo: https://github.com/gitleaks/gitleaks
    rev: {{ .Values.gitleaksRev | default "v8.21.2" }}
    hooks:
      - id: gitleaks
{{- range .Values.languages }}
{{- if eq . "go" }}

  - repo: https://github.com/dnephin/pre-commit-golang
    rev: v0.5.1
    hooks:
      - id: go-fmt
      - id: go-vet
      - id: go-mod-tidy
{{- end }}
{{- if eq . "python" }}

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.8.4
    hooks:
      - id: ruff
        args: [--fix]
      - id: ruff-format
{{- end }}
{{- if eq . "terraform" }}

  - repo: https://github.com/antonbabenko/pre-commit-terraform
    rev: v1.96.2
    hooks:
      - id: terraform_fmt
      - id: terraform_validate
      - id: terraform_tflint
{{- end }}
{{- end }}
